# Copy to deploy/.env. Keep the real file out of git.

# The address people use. Use http://localhost:8088 until the domain is connected.
PUBLIC_URL=http://localhost:8088
WEB_PORT=8088

# Generate each with: openssl rand -hex 32
JWT_SECRET=
POSTGRES_PASSWORD=
TEMPORAL_DB_PASSWORD=

# Only for plain HTTP on localhost. Remove it once the site runs on https.
NOT_SECURED=true

# Stays true until payments exist: with billing off, every account counts as fully
# paid. Only the first account can sign up while this is on.
DISABLE_REGISTRATION=true

# Remove once the Stripe keys are added below.
ALLOW_UNBILLED_LOCAL_DEV=true
#STRIPE_PUBLISHABLE_KEY=
#STRIPE_SECRET_KEY=
#STRIPE_SIGNING_KEY=

# Social channel keys go here as each developer account is approved, for example:
#X_API_KEY=
#X_API_SECRET=
#YOUTUBE_CLIENT_ID=
#YOUTUBE_CLIENT_SECRET=
